{
  "name": "tessa-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Static TesSa product website",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/create-static-aliases.mjs && node scripts/verify-static-output.mjs",
    "start:static": "node scripts/serve-static.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "verify:output": "node scripts/verify-static-output.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "deploy": "npm run verify && gh-pages -d out --nojekyll",
    "deploy:static": "npm run verify && gh-pages -d out --nojekyll"
  },
  "author": "Baleen Developers",
  "license": "ISC",
  "homepage": "https://baleendevs.github.io/tessa",
  "dependencies": {
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.3",
    "eslint-config-next": "16.3.4",
    "gh-pages": "6.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
